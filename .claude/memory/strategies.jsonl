{"id": "debug_systematic", "name": "Systematic Debugging", "description": "Methodical approach to finding and fixing bugs", "domain": "debugging", "task_types": ["debugging", "fix", "error"], "steps": ["1. Reproduce the error consistently", "2. Read the error message and stack trace carefully", "3. Form hypothesis about the cause", "4. Add logging/prints to verify hypothesis", "5. Fix the root cause, not just symptoms", "6. Verify the fix doesn't break other things", "7. Add a test to prevent regression"], "preconditions": ["error reported", "bug mentioned", "fix requested"], "success_rate": 0.8900319988369327, "uses_count": 0, "last_used": null}
{"id": "writing_structured", "name": "Structured Writing", "description": "Clear, organized approach to content creation", "domain": "writing", "task_types": ["writing", "draft", "article", "documentation", "content"], "steps": ["1. Define the purpose and audience", "2. Outline main points and structure", "3. Write a compelling hook/introduction", "4. Develop each section with supporting details", "5. Ensure logical flow between sections", "6. Write a strong conclusion with call-to-action", "7. Edit for clarity, conciseness, and tone"], "preconditions": ["write", "draft", "article", "document", "newsletter", "tutorial", "script", "screenplay", "essay", "blog post"], "success_rate": 0.9492519466797129, "uses_count": 0, "last_used": null}
{"id": "atom_of_thought", "name": "Atom of Thought", "description": "Decompose into independent atoms, validate each, synthesize", "domain": "reasoning", "task_types": ["evaluate", "compare", "analyze", "multi-part", "requirements"], "steps": ["1. Identify if problem is decomposable (not sequential)", "2. Break problem into independent atomic claims", "3. Verify each atom is self-contained (no 'this', 'therefore')", "4. Validate independence between atoms", "5. Verify correctness of each atom individually", "6. Assign confidence score to each validated atom", "7. Synthesize validated atoms into final answer", "8. Check synthesis consistency and completeness"], "preconditions": ["evaluate options", "compare alternatives", "assess tradeoffs", "weigh factors", "analyze requirements", "which approach", "pros and cons", "decision between"], "success_rate": 0.999980573684099, "uses_count": 0, "last_used": null}
{"id": "code_tdd", "name": "Test-Driven Development", "description": "Write tests first, then implementation", "domain": "coding", "task_types": ["implement", "feature", "coding"], "steps": ["1. Understand requirements fully", "2. Write failing test for simplest case", "3. Write minimal code to pass test", "4. Refactor while keeping tests green", "5. Add tests for edge cases", "6. Implement edge case handling", "7. Review and document"], "preconditions": ["implement", "build feature", "add feature", "code", "function", "class", "component", "endpoint", "api"], "success_rate": 0.951455474785665, "uses_count": 0, "last_used": null}
{"id": "research_triangulate", "name": "Triangulated Research", "description": "Verify findings through multiple sources", "domain": "research", "task_types": ["research", "investigate", "analyze"], "steps": ["1. Define the research question clearly", "2. Identify multiple source types (docs, code, web)", "3. Gather information from each source", "4. Cross-reference findings for consistency", "5. Note conflicts and uncertainties", "6. Synthesize into coherent answer", "7. State confidence level and caveats"], "preconditions": ["research", "find out", "investigate", "what is"], "success_rate": 0.8689280000000001, "uses_count": 0, "last_used": null}
